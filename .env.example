# ==========================================
# Kairo - Environment Variables Template
# Copy this file to .env and adjust variables as needed
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==========================================

# OpenRouter & Model Router Configuration (Task 3)
OPENROUTER_API_KEY=
KAIRO_MODEL=openrouter/free
KAIRO_ROUTING_ENABLED=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Kairo

# Database & Persistent Memory Configuration (Task 5)
DATABASE_URL=
REDIS_URL=

# Embedding Provider Configuration (Task 5)
# Options: deterministic (for local testing/zero external deps), openai, or openrouter
KAIRO_EMBEDDING_PROVIDER=
KAIRO_EMBEDDING_MODEL=

# Memory System Context Bounds (Task 5)
KAIRO_MEMORY_TOP_K=5
KAIRO_MAX_CONTEXT_MESSAGES=20
KAIRO_REDIS_TTL_SECONDS=3600

# Intelligent Memory Extraction (Task 6)
KAIRO_MEMORY_EXTRACTION_ENABLED=true
KAIRO_MEMORY_DEDUP_THRESHOLD=0.90
KAIRO_MEMORY_EXTRACTION_CAPABILITY=fast

# Web Research System (Task 7)
# Options: mock, duckduckgo, tavily, brave (leave empty for graceful unconfigured fallback)
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_REDIRECTS=3
WEB_MAX_EXTRACTED_CHARS=30000
KAIRO_MAX_RESEARCH_ITERATIONS=3
KAIRO_WEB_CACHE_TTL_SECONDS=900

# Browser Control System (Task 8)
KAIRO_BROWSER_ENABLED=true
KAIRO_BROWSER_HEADLESS=true
KAIRO_BROWSER_MAX_SESSIONS=3
KAIRO_BROWSER_SESSION_TIMEOUT_SECONDS=900
KAIRO_BROWSER_NAVIGATION_TIMEOUT_SECONDS=15
KAIRO_BROWSER_ACTION_TIMEOUT_SECONDS=10
KAIRO_BROWSER_MAX_PAGES_PER_SESSION=5
KAIRO_BROWSER_MAX_TEXT_CHARS=20000
KAIRO_BROWSER_MAX_ELEMENTS=200
KAIRO_BROWSER_MAX_LINKS=100

# Voice System Configuration (Task 9)
KAIRO_VOICE_ENABLED=true
KAIRO_STT_PROVIDER=mock
KAIRO_STT_MODEL=whisper-1
KAIRO_STT_API_KEY=
KAIRO_STT_BASE_URL=
KAIRO_TTS_PROVIDER=mock
KAIRO_TTS_MODEL=tts-1
KAIRO_TTS_VOICE=alloy
KAIRO_TTS_API_KEY=
KAIRO_TTS_BASE_URL=
KAIRO_VOICE_SAMPLE_RATE=16000
KAIRO_VOICE_MAX_SESSION_SECONDS=1800
KAIRO_VOICE_MAX_AUDIO_CHUNK_BYTES=65536
KAIRO_VOICE_MAX_MESSAGE_SECONDS=60
KAIRO_VOICE_MAX_CONCURRENT_SESSIONS=5

# Developer & GitHub Intelligence Configuration (Task 12)
KAIRO_DEVELOPER_ENABLED=true
KAIRO_REPOSITORY_ROOTS=
KAIRO_GITHUB_ENABLED=false
KAIRO_GITHUB_TOKEN=
KAIRO_MAX_GIT_LOG_ENTRIES=50
KAIRO_MAX_DIFF_CHARS=50000
KAIRO_MAX_CODE_SEARCH_RESULTS=50
KAIRO_MAX_CODE_SEARCH_FILE_SIZE=1000000
KAIRO_ALLOWED_TEST_COMMANDS=

# Automation & Workflow Engine Configuration (Task 13)
KAIRO_AUTOMATION_ENABLED=true
KAIRO_WORKFLOW_TIMEOUT_SECONDS=900
KAIRO_WORKFLOW_STEP_TIMEOUT_SECONDS=120
KAIRO_MAX_WORKFLOWS_PER_USER=50
KAIRO_MAX_CONCURRENT_WORKFLOW_RUNS=5
KAIRO_MIN_SCHEDULE_INTERVAL_SECONDS=60
KAIRO_WORKFLOW_MAX_RETRIES=3
KAIRO_APPROVAL_TIMEOUT_SECONDS=30

# Security, Permissions, Approval & Audit Center (Task 14)
KAIRO_SECURITY_ENABLED=true
KAIRO_AUDIT_ENABLED=true
KAIRO_COMPUTER_ENABLED=false

# Proactive Intelligence Configuration (Task 15)
KAIRO_PROACTIVE_ENABLED=true
KAIRO_PROACTIVE_DEDUP_WINDOW_SECONDS=3600
KAIRO_MAX_PROACTIVE_NOTIFICATIONS_PER_HOUR=20
KAIRO_MAX_PROACTIVE_INSIGHTS_PER_HOUR=50
KAIRO_MAX_PROACTIVE_CHAIN_DEPTH=3

# Multi-Agent Orchestration Configuration (Task 16)
KAIRO_MULTI_AGENT_ENABLED=true
KAIRO_MAX_AGENT_TASKS=8
KAIRO_MAX_PARALLEL_AGENTS=3
KAIRO_AGENT_TIMEOUT_SECONDS=300
KAIRO_AGENT_TOOL_TIMEOUT_SECONDS=60
KAIRO_MAX_AGENT_TOOL_CALLS=20
KAIRO_MAX_TOTAL_AGENT_TOOL_CALLS=50
KAIRO_MAX_AGENT_TOKENS_PER_TASK=
KAIRO_MAX_TOTAL_AGENT_TOKENS=

# Application Settings

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kairo Personal AI Assistant"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
