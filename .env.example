# ==========================================
# Kairo - Environment Variables Template
# Copy this file to .env and adjust variables as needed
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==========================================

# OpenRouter & Model Router Configuration (Task 3)
OPENROUTER_API_KEY=
KAIRO_MODEL=openrouter/free
KAIRO_ROUTING_ENABLED=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Kairo

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kairo Personal AI Assistant"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
