# ==========================================
# Kairo - Environment Variables Template
# Copy this file to .env and adjust variables as needed
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kairo Personal AI Assistant"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenRouter / LLM Configuration (Phase 2+)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-3.7-sonnet

# Secret Key for Security / JWT (Phase 2+)
SECRET_KEY=generate_a_secure_random_secret_key_here
