# ==========================================
# Kairo Environment Configuration: DEVELOPMENT
# Safe local defaults with debug logging and mock fallbacks
# ==========================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kairo Personal AI Assistant (Dev)"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=DEBUG

# Domain & CORS Configuration
KAIRO_PUBLIC_API_URL=http://localhost:8000
KAIRO_FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Session Security (Local development secret)
AUTH_SECRET_KEY=dev-insecure-secret-key-do-not-use-in-production-min32chars
SECRET_KEY=dev-secret-key-only-for-local-testing
KAIRO_AUTH_SESSION_TTL_SECONDS=86400
KAIRO_AUTH_IDLE_TIMEOUT_SECONDS=1800

# OpenRouter & Model Router (Optional in dev, mock available)
OPENROUTER_API_KEY=
KAIRO_MODEL=openrouter/free
KAIRO_ROUTING_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Kairo-Dev

# Database & Cache (Local Docker or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://kairo:kairo_pass@localhost:5432/kairo_dev
REDIS_URL=redis://localhost:6379/0
KAIRO_DB_POOL_SIZE=5
KAIRO_DB_MAX_OVERFLOW=5
KAIRO_DB_POOL_TIMEOUT=30
KAIRO_DB_POOL_RECYCLE=1800

# Embeddings & Memory (Deterministic for offline dev)
KAIRO_EMBEDDING_PROVIDER=deterministic
KAIRO_MEMORY_EXTRACTION_ENABLED=true
KAIRO_MEMORY_DEDUP_THRESHOLD=0.90

# Rate Limiting (Permissive for development)
RATE_LIMIT_REQUESTS_PER_MINUTE=600

# Feature Flags & Capabilities
KAIRO_SECURITY_ENABLED=true
KAIRO_AUDIT_ENABLED=true
KAIRO_COMPUTER_ENABLED=false # Kept false unless local agent is explicitly connected
KAIRO_VOICE_ENABLED=true
KAIRO_BROWSER_ENABLED=true
KAIRO_DEVELOPER_ENABLED=true
KAIRO_AUTOMATION_ENABLED=true
KAIRO_PROACTIVE_ENABLED=true
KAIRO_MULTI_AGENT_ENABLED=true
