# ==========================================
# Kairo Environment Configuration: PRODUCTION
# Enterprise production configuration template
# Inject these values via Cloud Secret Manager / Encrypted Vault
# NEVER COMMIT ACTUAL PRODUCTION SECRETS TO REPOSITORY
# ==========================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Kairo Personal AI Assistant"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Domain & CORS Configuration (Strictly restricted, no wildcards)
KAIRO_PUBLIC_API_URL=https://api.example.com
KAIRO_FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com

# Cryptographic Authentication & Session Security
# Generate using: openssl rand -hex 32 (Must be >= 32 characters)
AUTH_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY_MIN_32_BYTES
SECRET_KEY=REPLACE_WITH_SECONDARY_SYSTEM_SECRET_KEY_MIN_32_BYTES
KAIRO_AUTH_SESSION_TTL_SECONDS=86400  # 24 hours absolute maximum lifetime
KAIRO_AUTH_IDLE_TIMEOUT_SECONDS=1800  # 30 minutes maximum idle inactivity

# Upstream LLM Provider Configuration
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_PRODUCTION_OPENROUTER_KEY
KAIRO_MODEL=openrouter/auto
KAIRO_ROUTING_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://app.example.com
OPENROUTER_APP_NAME="Kairo Production"

# Managed PostgreSQL 16+ with pgvector & TLS
# Connection pool sizing: pool_size=20, max_overflow=10 per API instance
DATABASE_URL=postgresql+asyncpg://kairo_prod_user:REPLACE_WITH_PROD_DB_PASSWORD@prod-db.example.internal:5432/kairo_production?ssl=require
KAIRO_DB_POOL_SIZE=20
KAIRO_DB_MAX_OVERFLOW=10
KAIRO_DB_POOL_TIMEOUT=30
KAIRO_DB_POOL_RECYCLE=1800

# Managed Redis 7+ with TLS (rediss://)
REDIS_URL=rediss://default:REPLACE_WITH_PROD_REDIS_PASSWORD@prod-redis.example.internal:6379/0

# Embeddings & Memory Configuration
KAIRO_EMBEDDING_PROVIDER=openrouter
KAIRO_EMBEDDING_MODEL=text-embedding-3-small
KAIRO_MEMORY_EXTRACTION_ENABLED=true
KAIRO_MEMORY_DEDUP_THRESHOLD=0.90
KAIRO_MEMORY_TOP_K=5
KAIRO_MAX_CONTEXT_MESSAGES=20

# Rate Limiting & Abuse Prevention
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Security, Approvals & Audit Trail
KAIRO_SECURITY_ENABLED=true
KAIRO_AUDIT_ENABLED=true

# Capability Toggles & Cloud Safety Declarations
# CRITICAL: Desktop computer control is a local capability; MUST be false in cloud API
KAIRO_COMPUTER_ENABLED=false
KAIRO_VOICE_ENABLED=true
KAIRO_BROWSER_ENABLED=true
KAIRO_DEVELOPER_ENABLED=true
KAIRO_AUTOMATION_ENABLED=true
KAIRO_PROACTIVE_ENABLED=true
KAIRO_MULTI_AGENT_ENABLED=true

# Developer & GitHub Integration
KAIRO_GITHUB_ENABLED=true
KAIRO_GITHUB_TOKEN=ghp_REPLACE_WITH_SCOPED_GITHUB_APP_OR_PAT_TOKEN
KAIRO_MAX_DIFF_CHARS=50000
KAIRO_MAX_CODE_SEARCH_RESULTS=50

# Automation Engine Limits
KAIRO_WORKFLOW_TIMEOUT_SECONDS=900
KAIRO_WORKFLOW_STEP_TIMEOUT_SECONDS=120
KAIRO_MAX_WORKFLOWS_PER_USER=50
KAIRO_MAX_CONCURRENT_WORKFLOW_RUNS=5
KAIRO_MIN_SCHEDULE_INTERVAL_SECONDS=60
KAIRO_APPROVAL_TIMEOUT_SECONDS=600

# Multi-Agent Concurrency & Budget Controls
KAIRO_MAX_AGENT_TASKS=8
KAIRO_MAX_PARALLEL_AGENTS=3
KAIRO_AGENT_TIMEOUT_SECONDS=300
KAIRO_AGENT_TOOL_TIMEOUT_SECONDS=60
KAIRO_MAX_AGENT_TOOL_CALLS=20
KAIRO_MAX_TOTAL_AGENT_TOOL_CALLS=50
