# ==========================================
# Kairo Environment Configuration: STAGING
# Pre-production test environment with strict isolation from production
# NEVER point staging at production databases or production Redis
# ==========================================

# Core Application Settings
ENVIRONMENT=testing
DEBUG=false
PROJECT_NAME="Kairo Personal AI Assistant (Staging)"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Domain & CORS Configuration
KAIRO_PUBLIC_API_URL=https://staging-api.example.com
KAIRO_FRONTEND_URL=https://staging-app.example.com
ALLOWED_ORIGINS=https://staging-app.example.com

# Authentication & Session Security (Must be cryptographically random)
AUTH_SECRET_KEY=generate_staging_secret_with_at_least_32_bytes_entropy
SECRET_KEY=generate_staging_secondary_secret_key_minimum_32_bytes
KAIRO_AUTH_SESSION_TTL_SECONDS=86400
KAIRO_AUTH_IDLE_TIMEOUT_SECONDS=1800

# OpenRouter & Model Router
OPENROUTER_API_KEY=sk-or-v1-staging-quota-scoped-key-do-not-commit
KAIRO_MODEL=openrouter/free
KAIRO_ROUTING_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Kairo-Staging

# Managed Stateful Infrastructure (Isolated Staging DB & Redis)
DATABASE_URL=postgresql+asyncpg://kairo_stg_user:REPLACE_WITH_STAGING_PASSWORD@staging-db.example.internal:5432/kairo_staging?ssl=require
REDIS_URL=rediss://:REPLACE_WITH_STAGING_REDIS_PASSWORD@staging-redis.example.internal:6379/1
KAIRO_DB_POOL_SIZE=10
KAIRO_DB_MAX_OVERFLOW=5
KAIRO_DB_POOL_TIMEOUT=30
KAIRO_DB_POOL_RECYCLE=1800

# Embeddings & Memory (Using OpenAI or OpenRouter in staging)
KAIRO_EMBEDDING_PROVIDER=deterministic
KAIRO_MEMORY_EXTRACTION_ENABLED=true
KAIRO_MEMORY_DEDUP_THRESHOLD=0.90

# Rate Limiting & Safety Controls
RATE_LIMIT_REQUESTS_PER_MINUTE=120
KAIRO_SECURITY_ENABLED=true
KAIRO_AUDIT_ENABLED=true

# Capability Toggles
# Desktop computer control MUST be false in cloud staging
KAIRO_COMPUTER_ENABLED=false
KAIRO_VOICE_ENABLED=true
KAIRO_BROWSER_ENABLED=true
KAIRO_DEVELOPER_ENABLED=true
KAIRO_AUTOMATION_ENABLED=true
KAIRO_PROACTIVE_ENABLED=true
KAIRO_MULTI_AGENT_ENABLED=true

# Multi-Agent Resource Limits
KAIRO_MAX_AGENT_TASKS=8
KAIRO_MAX_PARALLEL_AGENTS=3
KAIRO_AGENT_TIMEOUT_SECONDS=300
KAIRO_AGENT_TOOL_TIMEOUT_SECONDS=60
KAIRO_MAX_AGENT_TOOL_CALLS=20
KAIRO_MAX_TOTAL_AGENT_TOOL_CALLS=50
